rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public site increments these anonymously — no auth required.
    match /likes/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /views/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /reactions/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Gallery content — public read, admin-only write.
    match /paintings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Audit log — append-only. Reads and most writes require the admin
    // session; a narrowly-shaped unauthenticated create is allowed only
    // for login_failed (the one event that happens before auth exists).
    match /audit_log/{docId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['type','email','details','timestamp'])
                    && request.resource.data.type in
                       ['login_success','painting_create','painting_update','painting_delete','paintings_bulk_import','session_kicked']
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.details is string
                    && request.resource.data.details.size() < 500
                    && request.resource.data.timestamp == request.time;

      allow create: if request.auth == null
                    && request.resource.data.keys().hasOnly(['type','email','details','timestamp'])
                    && request.resource.data.type == 'login_failed'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.details is string
                    && request.resource.data.details.size() < 500
                    && request.resource.data.timestamp == request.time;

      allow update: if false;
      allow delete: if false;
    }

    // Single active session per admin — doc ID is the admin's UID, so
    // each admin can only ever read/claim their own session slot.
    match /admin_session/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['sessionId','updatedAt'])
                   && request.resource.data.sessionId is string
                   && request.resource.data.sessionId.size() < 100
                   && request.resource.data.updatedAt == request.time;
    }
  }
}
